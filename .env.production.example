# Copy these keys into the hosting provider's secret/environment settings.
# Replace every placeholder. Never commit real secrets to source control.
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
ZERIHLINK_DATA_DIR=/opt/render/project/src/data
ZERIHLINK_BACKUP_RETENTION=14
ZERIHLINK_PERSISTENT_DATA_ACK=false
ZERIHLINK_TRUST_PROXY=true
ZERIHLINK_SESSION_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ZERIHLINK_REVIEWER_EMAILS=reviewer1@example.com,reviewer2@example.com
ZERIHLINK_PUBLIC_URL=https://your-real-domain.example
ZERIHLINK_DEPLOYMENT_URL=https://your-real-domain.example
ZERIHLINK_ALLOW_SIGNUP=false
ZERIHLINK_BETA_LEGAL_APPROVED=false
ZERIHLINK_BROWSER_QA_ACK=false
ZERIHLINK_LEGAL_REVIEW_ACK=false
ZERIHLINK_REVIEWER_COVERAGE_ACK=false
ZERIHLINK_OFFSITE_BACKUP_ACK=false
ZERIHLINK_EMAIL_WEBHOOK_URL=
ZERIHLINK_EMAIL_WEBHOOK_SECRET=
ZERIHLINK_EMAIL_FROM=
ZERIHLINK_APP_URL=https://your-real-domain.example
ZERIHLINK_REMOTE_PUBLIC_PROFILE_ID=
ZERIHLINK_REMOTE_PRIVATE_PROFILE_ID=
ZERIHLINK_STORAGE=json
