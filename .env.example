# Local development
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
ZERIHLINK_DATA_DIR=./data
ZERIHLINK_SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
ZERIHLINK_ALLOW_SIGNUP=true
ZERIHLINK_REVIEWER_EMAILS=
ZERIHLINK_PUBLIC_URL=https://your-domain.example
ZERIHLINK_LOCAL_BETA_TEST_MODE=false
ZERIHLINK_STORAGE=json
