# Local development
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
ZERIHLINK_DATA_DIR=./data
ZERIHLINK_SESSION_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ZERIHLINK_ALLOW_SIGNUP=true
ZERIHLINK_REVIEWER_EMAILS=
ZERIHLINK_PUBLIC_URL=https://zerilys.com
ZERIHLINK_LOCAL_BETA_TEST_MODE=false
ZERIHLINK_STORAGE=json

# Stripe server-side secrets only; never expose or commit real values.
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET
STRIPE_BILLING_ENABLED=false
